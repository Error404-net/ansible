# {{ ansible_managed }}
# AI agent. Revoke everywhere by removing agent_ssh_key and re-running baseline.
{% if agent_sudo == 'full' %}
{{ agent_user }} ALL=(ALL) NOPASSWD: ALL
{% else %}
Cmnd_Alias AGENT_RO = /usr/bin/systemctl status *, /usr/bin/systemctl list-units *, \
                      /usr/bin/journalctl *, /usr/bin/apt list --upgradable, \
                      /usr/bin/docker ps *, /usr/bin/docker logs *, /usr/bin/docker inspect *, \
                      /usr/bin/docker compose ls, /usr/bin/ss -tulpn, /usr/sbin/ss -tulpn
{{ agent_user }} ALL=(root) NOPASSWD: AGENT_RO
{% endif %}
